# Required
OPENAI_API_KEY=sk-...

# Optional. Runtime overrides set via Claude (voice_configure) take precedence over these.
# VOICE_TTS_VOICE=marin            # alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse, marin, cedar
# VOICE_TTS_MODEL=gpt-4o-mini-tts  # or tts-1, tts-1-hd (no style instructions with those)
# VOICE_TTS_INSTRUCTIONS=Cheerful and curious, at a slightly faster than normal pace.
# VOICE_TTS_SPEED=1.0              # 0.25 to 4.0

# Optional: force a specific audio player. Default: ffplay > mpv > afplay > aplay > paplay.
# Use {file} as a placeholder for a temp file; without it, audio is streamed via stdin.
# VOICE_PLAYER=afplay {file}
