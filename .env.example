# Required: the API key of the provider you use
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...               # for the Google provider (GOOGLE_API_KEY also works)

# Optional. Runtime overrides set via Claude (voice_configure) take precedence over these.
# VOICE_TTS_PROVIDER=openai        # openai or google
# VOICE_TTS_VOICE=marin            # OpenAI: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse, marin, cedar
#                                  # Google: Kore (default), Puck, Zephyr, Charon, Aoede, ... (30 voices, see README)
# VOICE_TTS_MODEL=gpt-4o-mini-tts  # OpenAI: gpt-4o-mini-tts, tts-1, tts-1-hd (no style instructions with the tts-1 models)
#                                  # Google: gemini-3.8-flash-tts (default), gemini-3.8-flash-lite-tts
# VOICE_TTS_INSTRUCTIONS=Cheerful and curious, at a slightly faster than normal pace.
# VOICE_TTS_SPEED=1.0              # 0.25 to 4.0, OpenAI only

# Optional: force a specific audio player. Default: ffplay > mpv > afplay > aplay > paplay.
# Use {file} as a placeholder for a temp file; without it, audio is streamed via stdin.
# VOICE_PLAYER=afplay {file}
